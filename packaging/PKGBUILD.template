# Maintainer: ChTPwner
pkgname=gotosplitter
pkgver=@@VERSION@@
pkgrel=1
pkgdesc="Cross-platform SNES autosplitter bridging SNI/QUsb2Snes to LiveSplit One"
arch=('x86_64')
url="https://github.com/chtpwner/GotoSplitter"
license=('MIT')
depends=('libx11' 'libxcursor' 'libxrandr' 'libxinerama' 'libxi' 'mesa')
makedepends=('go>=1.22')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/chtpwner/GotoSplitter/archive/v${pkgver}.tar.gz")
sha256sums=('@@SHA256@@')

build() {
  cd "GotoSplitter-${pkgver}"
  export CGO_ENABLED=1
  go build -trimpath -ldflags="-s -w" -o gotosplitter .
}

package() {
  cd "GotoSplitter-${pkgver}"
  install -Dm755 gotosplitter "${pkgdir}/usr/bin/gotosplitter"
  install -Dm644 packaging/gotosplitter.desktop "${pkgdir}/usr/share/applications/gotosplitter.desktop"
  install -Dm644 packaging/gotosplitter.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/gotosplitter.png"
  install -d "${pkgdir}/usr/share/gotosplitter/definitions"
  cp -r config/definitions/*.json "${pkgdir}/usr/share/gotosplitter/definitions/" 2>/dev/null || true
}
